Q.1
import pandas as pd
import matplotlib.pyplot as plt
df = pd.read_csv('/content/NetFlix - NetFlix.csv')
genre = df['genres'].dropna()
# Split multiple genres
genre = genre.str.split(', ').explode()
genre_count = genre.value_counts()
print("Top 10 Genres")
print(genre_count.head(10))
print("\nBottom 10 Genres")
print(genre_count.tail(10))
print("\nMost Popular Genre")
print(genre_count.idxmax(), "-", genre_count.max())
print("\nLeast Popular Genre")
print(genre_count.idxmin(), "-", genre_count.min())
# Bar Chart
genre_count.head(10).plot(kind='bar', figsize=(10,5), color='skyblue')
plt.title("Top 10 Netflix Genres")
plt.xlabel("Genre")
plt.ylabel("Count")
plt.xticks(rotation=45)
plt.show()

