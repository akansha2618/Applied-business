Q.3
# Remove missing values from country column
countries = df['country'].dropna()
# Split multiple countries into separate rows
countries = countries.str.split(', ').explode()
# Count content for each country
country_count = countries.value_counts()
# Country with the highest Netflix content
print("Country with the Highest Netflix Content:")
print(country_count.idxmax(), "-", country_count.max())
# Top 10 Countries
top10 = country_count.head(10)
print("\nTop 10 Countries:")
print(top10)
# Bottom 10 Countries
bottom10 = country_count.tail(10)
print("\nBottom 10 Countries:")
print(bottom10)
# Horizontal Bar Chart for Top 10 Countries
plt.figure(figsize=(10,6))
top10.sort_values().plot(kind='barh', color='orange', edgecolor='black')
plt.title("Top 10 Countries by Netflix Content")
plt.xlabel("Number of Titles")
plt.ylabel("Country")
plt.grid(axis='x', linestyle='--', alpha=0.7)
plt.show()

Q.4
# Remove missing values from director column
df = df.dropna(subset=['director'])
# Split multiple directors into separate rows
df['director'] = df['director'].str.split(', ')
df = df.explode('director')
# Director with Highest Number of Movies
movie_directors = df[df['type'] == 'Movie']['director'].value_counts()
print("Director with Highest Number of Movies:")
print(movie_directors.head(1))
# Director with Highest Number of TV Shows
tv_directors = df[df['type'] == 'TV Show']['director'].value_counts()
print("\nDirector with Highest Number of TV Shows:")
print(tv_directors.head(1))
# Top 10 Directors Overall
top10_directors = df['director'].value_counts().head(10)
print("\nTop 10 Directors:")
print(top10_directors)
# Plot Bar Chart
plt.figure(figsize=(10,6))
top10_directors.plot(kind='bar', color='green', edgecolor='black')
plt.title("Top 10 Directors on Netflix")
plt.xlabel("Director")
plt.ylabel("Number of Titles")
plt.xticks(rotation=45, ha='right')
plt.grid(axis='y', linestyle='--', alpha=0.7)

