# Count releases
before_2020 = df[df['release_year'] < 2020].shape[0]
during_2020 = df[df['release_year'] == 2020].shape[0]
after_2020 = df[df['release_year'] > 2020].shape[0]
# Display Counts
print("Netflix Releases")
print("Before 2020 :", before_2020)
print("During 2020 :", during_2020)
print("After 2020  :", after_2020)
# Data for Chart
categories = ['Before 2020', 'During 2020', 'After 2020']
counts = [before_2020, during_2020, after_2020]
# Bar Chart
plt.figure(figsize=(8,5))
plt.bar(categories, counts, color=['blue', 'orange', 'green'], edgecolor='black')
plt.title("Comparison of Netflix Releases")
plt.xlabel("Release Period")
plt.ylabel("Number of Titles")
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.show()

