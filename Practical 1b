import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
df = pd.read_csv("titanic passenger list.csv")
print(df["Product Category"].value_counts())
df["survived"].value_counts().plot(kind="bar")
plt.title("Survived Category Analysis")
plt.xlabel("Survived Category")
plt.show()
print(df["pclass"].value_counts())
df["pclass"].value_counts().plot(kind="bar")
plt.title("Pclass Analysis")
plt.xlabel("pclass")
plt.show()
print(df["fare"].value_counts())
df["fare"].value_counts().plot(kind="bar")
plt.title("Fare")
plt.xlabel("fare")
plt.show()
print(df["survived"].value_counts())
df["survived"].value_counts().plot(kind="pie", autopct="%1.1f%%")
plt.title("survived")
plt.ylabel("")
plt.show()
plt.hist(df["parch"], bins=10)
plt.title("Parch Distribution")
plt.xlabel("Parch")
plt.show()
plt.hist(df["age"], bins=10)
plt.title("Age Distribution")
plt.xlabel("age")
plt.show()
plt.scatter(df["age"], df["fare"])
plt.title("Age VS Fare")
plt.xlabel("age")
plt.ylabel("fare")
plt.show()
sns.heatmap(df.corr(numeric_only=True), annot=True, cmap="Oranges")
plt.title("Correlation Heatmap")
plt.show()
